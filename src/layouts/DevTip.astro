---
import Base from "./Base.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={title}>
  <div id="content_header" class="hidden flex items-center justify-center flex-wrap px-6 py-4 fixed w-full z-10 top-0 bg-gray-50 shadow-lg">
    <h1 class="mb-2 font-bold text-center text-gray-800 md:text-xl lg:text-2xl xl:text-3xl md:leading-tight">
      {title}
    </h1>
  </div>

  <div class="max-w-screen-md mx-auto prose lg:prose-lg p-4">
    <h1 class="mb-2 text-3xl font-bold text-gray-900 md:text-2xl lg:text-4xl xl:text-5xl md:leading-tight">
      {title}
    </h1>
  </div>

  <div class="post-content max-w-screen-md mx-auto prose lg:prose-lg">
    <slot />
  </div>
</Base>
